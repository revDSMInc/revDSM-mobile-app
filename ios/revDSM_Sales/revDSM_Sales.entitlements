<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push Notifications.

	  `development` is correct for debug builds AND for TestFlight/App Store: Xcode
	  rewrites it to `production` when it signs a release with a distribution
	  profile. Hard-coding `production` here breaks push on every device build.

	  Without this key the app registers with APNs and is refused, so
	  `getToken()` never resolves an FCM token and no notification is ever
	  delivered — with nothing visible on the device to say why.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
